    <style name="MenuDialogTheme" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="StandardIconStyle">
        <item name="android:layout_width">@dimen/standard_icon_size</item>
        <item name="android:layout_height">@dimen/standard_icon_size</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="LongButton">
        <item name="android:textSize">@dimen/semi_large_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/highlight_button_text_colors</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_height">60.0dp</item>
        <item name="android:layout_marginLeft">12.0dp</item>
        <item name="android:layout_marginRight">12.0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:shadowDx">0.0</item>
        <item name="android:shadowDy">-2.0</item>
        <item name="android:shadowRadius">0.1</item>
        <item name="backgroundShadow">@drawable/shrink_long_btn_shadow_normal</item>
        <item name="shadowButtonStyle">longButton</item>
    </style>
    <style name="LongButton.Shrink" parent="@style/LongButton">
        <item name="android:layout_height">48.0dp</item>
        <item name="backgroundShadow">@drawable/shrink_long_btn_shadow_normal</item>
        <item name="shadowButtonStyle">shrink_longButton</item>
    </style>
    <style name="LongButton.Shrink.Highlight" parent="@style/LongButton.Shrink">
        <item name="android:layout_height">48.0dp</item>
    </style>
    <style name="LongButton.Shrink.Highlight.Red" parent="@style/LongButton.Shrink.Highlight">
        <item name="android:background">@drawable/shrink_long_btn_red_selector</item>
        <item name="android:layout_height">48.0dp</item>
    </style>

    <style name="StickyListHeaderStyle">
        <item name="android:textSize">@dimen/semi_small_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sticky_list_header_text_color</item>
        <item name="android:gravity">left|center</item>
        <item name="android:background">@drawable/list_section_title</item>
        <item name="android:paddingLeft">12.0dp</item>
    </style>
    <style name="Suggestion">
        <item name="android:background">@drawable/list_item_nophoto_bg</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/suggestion_view_height</item>
    </style>
    <style name="SuggestionIcon1">
        <item name="android:layout_width">@dimen/screen_suggestion</item>
        <item name="android:layout_height">@dimen/screen_suggestion</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:layout_centerInParent">true</item>
    </style>
    <style name="SuggestionIcon2">
        <item name="android:layout_width">@dimen/suggestion_icon_size</item>
        <item name="android:layout_height">@dimen/suggestion_icon_size</item>
        <item name="android:scaleType">centerInside</item>

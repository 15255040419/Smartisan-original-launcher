<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@+id/menu_dialog_title_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_title_bar_bg"
        android:minHeight="48.0dp">
        <ImageView
            android:id="@+id/btn_cancel_left"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/bar_margin_edge"
            android:contentDescription="@string/smt_cancel"
            android:src="@drawable/standard_icon_cancel_selector"
            android:visibility="invisible"
            style="@style/StandardIconStyle" />
        <ImageView
            android:id="@+id/btn_cancel_right"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/bar_margin_edge"
            android:contentDescription="@string/smt_cancel"
            android:src="@drawable/standard_icon_cancel_selector"
            style="@style/StandardIconStyle" />
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="6.0dp"
            android:layout_marginRight="6.0dp"
            android:layout_toLeftOf="@id/btn_cancel_right"
            android:layout_toRightOf="@id/btn_cancel_left"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/smartisan_title_text_color"
            android:textSize="@dimen/semi_small_text_size"
            android:textStyle="bold" />
    </RelativeLayout>
</merge>

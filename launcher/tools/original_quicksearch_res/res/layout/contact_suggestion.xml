<?xml version="1.0" encoding="utf-8"?>
<view xmlns:android="http://schemas.android.com/apk/res/android"
    class="com.android.quicksearchbox.ui.ContactSuggestionView" style="@style/Suggestion">
    <RelativeLayout android:id="@+id/icon_container" android:layout_width="@dimen/suggestion_view_height" android:layout_height="@dimen/suggestion_view_height">
        <ImageView android:id="@+id/icon1" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerInParent="true" android:scaleType="centerCrop" />
    </RelativeLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toRightOf="@id/icon_container" android:orientation="vertical">
        <TextView android:id="@+id/text1" style="@style/SuggestionText1" />
        <TextView android:id="@+id/text2" style="@style/SuggestionText2" />
    </LinearLayout>
</view>

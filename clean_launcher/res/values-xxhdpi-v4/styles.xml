<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="unlocker">
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerHorizontal">true</item>
    </style>
    <style name="unlocker.button" parent="@style/unlocker.text">
        <item name="android:textSize">@dimen/unlocker_txt_button_finger_txt</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/selector_keyboard_blank</item>
        <item name="android:layout_width">0.0dp</item>
        <item name="android:layout_height">@dimen/unlocker_button_height</item>
        <item name="android:layout_weight">1.0</item>
    </style>
    <style name="unlocker.faceid" parent="@style/unlocker">
        <item name="android:textSize">@dimen/unlocker_faceid_text_size</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">@dimen/unlocker_faceid_tips_margin_top</item>
        <item name="android:shadowColor">@color/faceid_popup_shadow</item>
        <item name="android:shadowDy">1.0</item>
        <item name="android:shadowRadius">1.0</item>
    </style>
    <style name="unlocker.keyboard" parent="@style/unlocker">
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">0.0dp</item>
        <item name="android:layout_height">0.0dp</item>
        <item name="android:layout_weight">1.0</item>
    </style>
    <style name="unlocker.keyboard.button" parent="@style/unlocker.keyboard">
        <item name="android:textSize">@dimen/unlocker_txt_button_num</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">@dimen/keyboard_button_margin</item>
    </style>
    <style name="unlocker.keyboard.line" parent="@style/unlocker.keyboard">
        <item name="android:layout_width">match_parent</item>
    </style>
    <style name="unlocker.keyboard.textBtn" parent="@style/unlocker.keyboard">
        <item name="android:textSize">@dimen/unlocker_txt_button_txt</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">@dimen/keyboard_button_margin</item>
    </style>
    <style name="unlocker.pin" parent="@style/unlocker">
        <item name="android:layout_width">@dimen/unlocker_pin_dot_size</item>
        <item name="android:layout_height">@dimen/unlocker_pin_dot_size</item>
        <item name="android:layout_marginLeft">@dimen/unlocker_pin_space</item>
        <item name="android:layout_marginRight">@dimen/unlocker_pin_space</item>
    </style>
    <style name="unlocker.text" parent="@style/unlocker">
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="unlocker.text.light" parent="@style/unlocker.text">
        <item name="android:textSize">@dimen/unlocker_txt_secondary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="unlocker.text.main" parent="@style/unlocker.text">
        <item name="android:textSize">@dimen/unlocker_txt_main</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<merge android:background="@android:color/transparent" android:layout_width="wrap_content" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:id="@id/line_0" style="@style/unlocker.keyboard.line">
        <Button android:id="@id/keyboard_1" android:background="@drawable/selector_keyboard_1" android:contentDescription="@string/description_1" style="@style/unlocker.keyboard.button" />
        <Button android:id="@id/keyboard_2" android:background="@drawable/selector_keyboard_2" android:contentDescription="@string/description_2" style="@style/unlocker.keyboard.button" />
        <Button android:id="@id/keyboard_3" android:background="@drawable/selector_keyboard_3" android:contentDescription="@string/description_3" style="@style/unlocker.keyboard.button" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:id="@id/line_1" style="@style/unlocker.keyboard.line">
        <Button android:id="@id/keyboard_4" android:background="@drawable/selector_keyboard_4" android:contentDescription="@string/description_4" style="@style/unlocker.keyboard.button" />
        <Button android:id="@id/keyboard_5" android:background="@drawable/selector_keyboard_5" android:contentDescription="@string/description_5" style="@style/unlocker.keyboard.button" />
        <Button android:id="@id/keyboard_6" android:background="@drawable/selector_keyboard_6" android:contentDescription="@string/description_6" style="@style/unlocker.keyboard.button" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:id="@id/line_2" style="@style/unlocker.keyboard.line">
        <Button android:id="@id/keyboard_7" android:background="@drawable/selector_keyboard_7" android:contentDescription="@string/description_7" style="@style/unlocker.keyboard.button" />
        <Button android:id="@id/keyboard_8" android:background="@drawable/selector_keyboard_8" android:contentDescription="@string/description_8" style="@style/unlocker.keyboard.button" />
        <Button android:id="@id/keyboard_9" android:background="@drawable/selector_keyboard_9" android:contentDescription="@string/description_9" style="@style/unlocker.keyboard.button" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:id="@id/line_3" android:layout_alignParentBottom="true" style="@style/unlocker.keyboard.line">
        <Button android:id="@id/keyboard_cancel" android:background="@drawable/selector_keyboard_blank" android:text="@string/unlocker_cancel" android:contentDescription="@string/description_cancel" style="@style/unlocker.keyboard.textBtn" />
        <Button android:id="@id/keyboard_0" android:background="@drawable/selector_keyboard_0" android:contentDescription="@string/description_0" style="@style/unlocker.keyboard.button" />
        <ViewSwitcher android:id="@id/keyboard_right_bottom_switcher" style="@style/unlocker.keyboard.button">
            <Button android:id="@id/keyboard_back" android:background="@drawable/selector_keyboard_back" android:layout_width="match_parent" android:layout_margin="0.0dp" android:contentDescription="@string/description_back" style="@style/unlocker.keyboard.textBtn" />
            <Button android:id="@id/keyboard_simple_verify" android:background="@drawable/selector_keyboard_blank" android:layout_width="match_parent" android:layout_margin="0.0dp" android:contentDescription="@string/description_fp" style="@style/unlocker.keyboard.textBtn" />
        </ViewSwitcher>
    </LinearLayout>
</merge>
